# Copy to .env and change the values. Real secrets never enter the repository.
POSTGRES_DB=studyhub
POSTGRES_USER=studyhub
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_PORT=5432

# API connection string (psycopg 3)
DATABASE_URL=postgresql+psycopg://studyhub:change-me-dev-only@localhost:5432/studyhub

# READ-ONLY user (created in Lab 11) for Postgres-MCP
STUDYHUB_RO_PASSWORD=change-me-ro-dev-only
STUDYHUB_RO_DATABASE_URL=postgresql://studyhub_ro:change-me-ro-dev-only@localhost:5432/studyhub

# Department time zone (deadlines are entered in it and stored in UTC)
DEPARTMENT_TZ=Europe/Kyiv

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Test secret for Lab 1 (checking .cursorignore); an invented value
TEST_SECRET=studyhub-lab1
